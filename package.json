{
  "name": "badje-web",
  "private": true,
  "version": "1.0.0",
  "description": "Système de génération de badges hors-ligne",
  "author": "Antigravity",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "app:dev": "concurrently -k \"cross-env BROWSER=none vite --port 5173 --strictPort\" \"wait-on http://localhost:5173 && cross-env NODE_ENV=development electron .\"",
    "app:build": "npm run build && electron-builder",
    "start:server": "node server-local/server.js"
  },
  "build": {
    "appId": "com.badjeweb.app",
    "productName": "GenerateurBadges",
    "directories": {
      "output": "build-out"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "win": {
      "target": "nsis"
    }
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dexie": "^4.4.4",
    "dexie-react-hooks": "^4.4.0",
    "express": "^5.2.1",
    "firebase": "^12.16.0",
    "html2canvas": "^1.4.1",
    "html2canvas-pro": "^2.2.4",
    "lucide-react": "^1.25.0",
    "pdfjs-dist": "^5.6.205",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.1",
    "sqlite": "^5.1.1",
    "sqlite3": "^6.0.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "autoprefixer": "^10.5.4",
    "concurrently": "^9.2.4",
    "cross-env": "^10.1.0",
    "electron": "^41.7.1",
    "electron-builder": "^26.15.3",
    "oxlint": "^1.71.0",
    "postcss": "^8.5.19",
    "tailwindcss": "^4.3.3",
    "vite": "^8.1.1",
    "wait-on": "^9.0.10"
  }
}
